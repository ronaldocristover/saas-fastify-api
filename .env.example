# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/api_dev

# Auth
JWT_ACCESS_SECRET=replace-with-random-32-char-string
JWT_REFRESH_SECRET=replace-with-random-32-char-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Observability
SWAGGER_ENABLED=true

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=20
DATABASE_POOL_MAX=10

# Seed script only (pnpm db:seed), not needed for app startup:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin123456