meta {
  name: Login as File Tester
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{fileUserEmail}}",
    "password": "password123"
  }
}

script:post-response {
  bru.setVar("fileAccessToken", res.getBody().data.accessToken);
  bru.setVar("fileUserId", res.getBody().data.user.id);
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("should return access token", function() {
    expect(res.getBody().data.accessToken).to.not.be.empty;
  });
}
