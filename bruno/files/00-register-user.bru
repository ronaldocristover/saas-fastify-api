meta {
  name: Register User (for file tests)
  type: http
  seq: 0
}

post {
  url: {{host}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "filetest@example.com",
    "password": "password123",
    "fullName": "File Tester"
  }
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 409) {
    bru.setVar("fileUserEmail", "filetest@example.com");
  }
}

tests {
  test("should succeed or already exist", function() {
    expect([201, 409]).to.include(res.getStatus());
  });
}
