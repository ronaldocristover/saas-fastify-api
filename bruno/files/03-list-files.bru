meta {
  name: List Files
  type: http
  seq: 3
}

get {
  url: {{host}}/api/v1/files?page=1&limit=10
  auth: none
}

headers {
  Authorization: Bearer {{fileAccessToken}}
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("should return paginated data", function() {
    expect(res.getBody()).to.have.property("data");
    expect(res.getBody()).to.have.property("meta");
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody().meta).to.have.property("page");
    expect(res.getBody().meta).to.have.property("total");
  });
}
