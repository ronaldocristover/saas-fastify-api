meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{host}}/api/v1/auth/logout
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("should return 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}