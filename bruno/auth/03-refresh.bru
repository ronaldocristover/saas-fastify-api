meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{host}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  bru.setVar("accessToken", res.getBody().data.accessToken);
  bru.setVar("refreshToken", res.getBody().data.refreshToken);
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return new tokens", function() {
    expect(res.getBody().data).to.have.property("accessToken");
    expect(res.getBody().data).to.have.property("refreshToken");
  });
}