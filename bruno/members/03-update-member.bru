meta {
  name: Update Member
  type: http
  seq: 3
}

patch {
  url: {{host}}/api/v1/members/{{memberId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "fullName": "Updated Name"
  }
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return updated member", function() {
    expect(res.getBody().data.fullName).to.equal("Updated Name");
  });
}