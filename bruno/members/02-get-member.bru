meta {
  name: Get Member
  type: http
  seq: 2
}

get {
  url: {{host}}/api/v1/members/{{memberId}}
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return member data", function() {
    expect(res.getBody().data).to.have.property("id");
    expect(res.getBody().data).to.have.property("email");
    expect(res.getBody().data).to.have.property("fullName");
  });
}