meta {
  name: Login as Admin
  type: http
  seq: 0
}

post {
  url: {{host}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.com",
    "password": "admin123456"
  }
}

script:post-response {
  bru.setVar("adminAccessToken", res.getBody().data.accessToken);
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return admin role", function() {
    expect(res.getBody().data.user.role).to.equal("admin");
  });
}