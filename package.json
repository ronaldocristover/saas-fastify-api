{
  "name": "fastify-api-boilerplate",
  "version": "0.1.0",
  "description": "Production-ready Fastify + PostgreSQL API boilerplate with layered architecture",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun --env-file=.env dist/server.js",
    "test": "bun test --no-parallel",
    "test:watch": "bun test --watch --no-parallel",
    "test:coverage": "bun test --coverage --no-parallel",
    "test:unit": "bun test tests/unit --no-parallel",
    "test:integration": "bun test tests/integration --no-parallel",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env drizzle-kit migrate",
    "db:seed": "bun --env-file=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "bruno:run": "cd bruno && bru run --env local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@usebruno/cli": "^1.40.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "trustedDependencies": [
    "argon2"
  ]
}